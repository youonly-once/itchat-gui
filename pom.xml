    <build>
        <plugins>
            <!--打包JAR配置-->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/*.properties</exclude>
                        <exclude>**/*.yml</exclude>
                        <exclude>**/*.xml</exclude>
                        <exclude>**/*.dic</exclude>
                        <exclude>**/*.model</exclude>
                        <exclude>**/*.txt</exclude>
                        <exclude>**/*.png</exclude>
                        <exclude>**/*.gif</exclude>
                        <exclude>**/*.jpg</exclude>
                        <exclude>**/*.jar</exclude>
                        <exclude>**/*.map</exclude>
                        <exclude>**/*.table</exclude>
                        <exclude>**/*.wav</exclude>
                        <exclude>**/*.db</exclude>
                        <exclude>lib</exclude>
                        <exclude>wav</exclude>
                        <exclude>mapper</exclude>
                        <exclude>image</exclude>import org.apache.commons.lang3.StringUtils;
                        <exclude>emoji</exclude>
                        <exclude>**/*.vbs</exclude>
                        <exclude>**/*.bat</exclude>
                    </excludes>
                    <outputDirectory>${output-directory}</outputDirectory>
                    <archive>
                        <manifest>
                            <mainClass>cn.shu.WeChatStater</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                            <!-- 打包时 MANIFEST.MF文件记录的时间戳版本 -->
                            <useUniqueVersions>true</useUniqueVersions>
                        </manifest>
                        <manifestEntries>
                            <!-- 在Class-Path下添加配置文件的路径 -->
                            <!--maven依赖为system的包需手动添加到manifest.MF文件中-->
                            <Class-Path>conf/ lib/jintellitype-1.3.9.jar lib/jna-4.4.0.jar lib/android.ninepatch-1.0.jar lib/jna-platform-4.4.0.jar
                            </Class-Path>

                        </manifestEntries>
                    </archive>
                </configuration>

            </plugin>
            <!--打包配置文件-->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-configuration-file</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${output-directory}/conf</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${basedir}/target/classes</directory>
                                    <includes>
                                        <include>**/*.properties</include>
                                        <include>**/*.yml</include>
                                        <include>**/*.xml</include>
                                        <include>**/*.dic</include>
                                        <include>**/*.model</include>
                                        <include>**/*.txt</include>
                                        <include>**/*.png</include>
                                        <include>**/*.gif</include>
                                        <include>**/*.jpg</include>
                                        <include>**/*.map</include>
                                        <include>**/*.table</include>
                                        <include>**/*.wav</include>
                                        <include>**/*.db</include>
                                        <include>**/*.vbs</include>
                                        <include>**/*.bat</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--打包依赖资源-->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-dependency</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${output-directory}/lib/</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>

    </build>
